# WorkMate AI Backend Environment Variables Example

# Application Runtime Environment & Logging
APP_ENV=dev # Application deployment environment (dev, staging, prod)
LOG_LEVEL=INFO # Global Python logger verbosity level (DEBUG, INFO, WARNING, ERROR)
FRONTEND_ORIGIN=http://localhost:3000 # Allowed CORS origin for Next.js frontend client

# Snowflake Managed Cloud Persistence & Cortex AI Services
SNOWFLAKE_ACCOUNT=your_org-your_account # Snowflake organization-account identifier
SNOWFLAKE_USER=your_service_user # Snowflake database service user
SNOWFLAKE_PASSWORD=replace_with_a_secret # Never commit the real password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH # Snowflake virtual warehouse for compute queries
SNOWFLAKE_DATABASE=WORKMATE_AI # Primary Snowflake database name
SNOWFLAKE_SCHEMA=KNOWLEDGE_STUDIO # Target Snowflake schema name
SNOWFLAKE_ROLE=SYSADMIN # Replace with the least-privileged backend role

# Copilot retrieval and generation
CORTEX_SEARCH_SERVICE=WORKMATE_AI.KNOWLEDGE_STUDIO.WORKMATE_KNOWLEDGE_SEARCH
CORTEX_COMPLETE_MODEL=mistral-large2
CORTEX_SEARCH_ENABLED=true
CORTEX_COMPLETE_ENABLED=true
COPILOT_RETRIEVAL_LIMIT=5
COPILOT_ALLOWED_KNOWLEDGE_STATUSES=published

# Security & RBAC Auth Configuration
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes # Never commit the real secret
JWT_ALGORITHM=HS256 # Cryptographic algorithm for JWT signature verification
JWT_ACCESS_EXPIRE_MINUTES=60 # Token expiration lifetime in minutes for access tokens
JWT_REFRESH_EXPIRE_DAYS=7 # Refresh token expiration duration in days

# Internal Webhook & Service Security
INTERNAL_WEBHOOK_SECRET=replace_with_a_random_internal_secret # Secret header token validating internal n8n callbacks

# n8n Automation Engine Webhooks
N8N_BASE_URL=http://localhost:5678 # Base URL for n8n orchestration instance
N8N_WEBHOOK_BASE_URL=http://localhost:5678 # Webhook base URL for outgoing n8n triggers
