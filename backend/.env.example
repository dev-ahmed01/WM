# WorkMate AI backend environment template.
# Copy to backend/.env, fill every blank secret locally, and never commit backend/.env.

APP_ENV=dev
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL is the sole source of truth; do not configure expired Snowflake.
# Host-native: localhost; inside Compose DATABASE_URL is injected automatically.
DATABASE_URL=postgresql://workmate:workmate_dev_only@localhost:5432/workmate
POSTGRES_POOL_SIZE=6
POSTGRES_POOL_TIMEOUT_SECONDS=5
SOURCE_OBJECT_MAX_BYTES=26214400

# Self-hosted Ollama runtime. For host-only development use http://127.0.0.1:11434.
LOCAL_AI_ENABLED=true
LOCAL_AI_BASE_URL=http://ollama:11434
LOCAL_CHAT_MODEL=qwen2.5:3b
LOCAL_EMBEDDING_MODEL=nomic-embed-text
LOCAL_AI_TIMEOUT_SECONDS=8
LOCAL_AI_CANDIDATE_LIMIT=100
LOCAL_AI_INDEX_MAX_CANDIDATES=5000
LOCAL_AI_MIN_SIMILARITY=0.35
COPILOT_MIN_CONFIDENCE_THRESHOLD=0.70
COPILOT_HISTORY_LIMIT=6


COPILOT_RETRIEVAL_LIMIT=5
COPILOT_ALLOWED_KNOWLEDGE_STATUSES=published

# Set true for production; required to revoke stale/disabled access tokens.
AUTH_REVALIDATE_DB=true
# Security controls are required together when APP_ENV=production.
AUTH_SESSION_STORE_ENABLED=true
AUTH_RATE_LIMIT_ENABLED=true
# Leave false behind a shared Next.js BFF unless real client IP is trusted.
AUTH_RATE_IP_BUCKET_ENABLED=false
POSTGRES_RLS_REFERENCES=true
AUTH_RATE_MAX_ATTEMPTS=10
AUTH_RATE_WINDOW_SECONDS=900
# Pilot is strictly opt-in to a named department cohort.
PILOT_FEEDBACK_ENABLED=false
PILOT_ALLOWED_DEPARTMENTS=
PILOT_FEEDBACK_MAX_PER_USER_PER_DAY=30
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
INTERNAL_WEBHOOK_SECRET=

N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_NOTIFICATIONS_ENABLED=false
