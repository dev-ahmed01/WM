# WorkMate AI backend environment template.
# Copy to backend/.env, replace placeholders locally, and never commit backend/.env.

APP_ENV=dev
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000

# Snowflake is durable relational storage and the OWD source stage only.
SNOWFLAKE_ACCOUNT=your_snowflake_account
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=replace_with_a_local_secret
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=WORKMATE_AI
SNOWFLAKE_SCHEMA=KNOWLEDGE_STUDIO
SNOWFLAKE_ROLE=your_least_privilege_runtime_role
SNOWFLAKE_POOL_SIZE=4
SNOWFLAKE_POOL_ACQUIRE_TIMEOUT_SECONDS=5
SNOWFLAKE_STAGE_NAME=RAW_OWD_STAGE
OWD_CLI_USER_ID=usr_admin001

# Self-hosted Ollama runtime. For host-only development use http://127.0.0.1:11434.
LOCAL_AI_ENABLED=true
LOCAL_AI_BASE_URL=http://ollama:11434
LOCAL_CHAT_MODEL=qwen2.5:3b
LOCAL_EMBEDDING_MODEL=nomic-embed-text
LOCAL_AI_TIMEOUT_SECONDS=8
LOCAL_AI_CANDIDATE_LIMIT=100
LOCAL_AI_INDEX_MAX_CANDIDATES=5000
LOCAL_AI_MIN_SIMILARITY=0.35
COPILOT_MIN_CONFIDENCE_THRESHOLD=0.70
COPILOT_HISTORY_LIMIT=6

COPILOT_RETRIEVAL_LIMIT=5
COPILOT_ALLOWED_KNOWLEDGE_STATUSES=published

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
INTERNAL_WEBHOOK_SECRET=replace_with_a_random_webhook_secret

N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_NOTIFICATIONS_ENABLED=false
