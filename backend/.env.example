# WorkMate AI backend environment template.
# Copy to backend/.env, replace placeholders locally, and never commit backend/.env.

APP_ENV=dev
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000

# Snowflake is durable relational storage and the OWD source stage only.
SNOWFLAKE_ACCOUNT=your_snowflake_account
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=replace_with_a_local_secret
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=WORKMATE_AI
SNOWFLAKE_SCHEMA=KNOWLEDGE_STUDIO
SNOWFLAKE_ROLE=your_least_privilege_runtime_role
SNOWFLAKE_POOL_SIZE=4
SNOWFLAKE_POOL_ACQUIRE_TIMEOUT_SECONDS=5
SNOWFLAKE_STAGE_NAME=RAW_OWD_STAGE
OWD_CLI_USER_ID=usr_admin001

# Self-hosted Ollama runtime. For host-only development use http://127.0.0.1:11434.
LOCAL_AI_ENABLED=true
LOCAL_AI_BASE_URL=http://ollama:11434
LOCAL_CHAT_MODEL=qwen2.5:3b
LOCAL_TRANSLATION_MODEL=qwen2.5:3b
LOCAL_EMBEDDING_MODEL=nomic-embed-text
LOCAL_AI_TIMEOUT_SECONDS=8
LOCAL_AI_CANDIDATE_LIMIT=100
LOCAL_AI_INDEX_MAX_CANDIDATES=5000
LOCAL_AI_MIN_SIMILARITY=0.35
COPILOT_MIN_CONFIDENCE_THRESHOLD=0.70
COPILOT_HISTORY_LIMIT=6

# English/Hindi voice: Faster-Whisper STT, compact CTranslate2 translation, Piper TTS.
VOICE_ENABLED=true
VOICE_SUPPORTED_LANGUAGES=en,hi
VOICE_MAX_AUDIO_BYTES=26214400
VOICE_AUDIO_DIR=/app/data/voice/audio
VOICE_AUDIO_TTL_SECONDS=3600
WHISPER_MODEL=base
WHISPER_FALLBACK_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_DOWNLOAD_ROOT=/app/data/voice/whisper
WHISPER_LARGE_MIN_MEMORY_GB=6
WHISPER_TRANSCRIPTION_TIMEOUT_SECONDS=300
WHISPER_BEAM_SIZE=1
WHISPER_CPU_THREADS=4
WHISPER_NUM_WORKERS=1
# Vocabulary hints improve recognition of operational nouns; these are not command rules.
WHISPER_HOTWORDS=package damaged damage inspection quarantine pallet barcode purchase order goods shipment trailer seal manifest warehouse inventory return batch picking पैकेज क्षतिग्रस्त नुकसान निरीक्षण क्वारंटीन पैलेट बारकोड खरीद आदेश माल शिपमेंट ट्रेलर सील मैनिफेस्ट गोदाम इन्वेंटरी वापसी बैच पिकिंग
WHISPER_HINDI_PROMPT=यह एक वेयरहाउस सहायता अनुरोध है। पैकेज सामान क्षतिग्रस्त नुकसान निरीक्षण क्वारंटीन पैलेट बारकोड खरीद आदेश शिपमेंट प्राप्ति गोदाम इन्वेंटरी वापसी मुझे क्या करना चाहिए।
PIPER_VOICE_DIR=/app/data/voice/piper
PIPER_USE_CUDA=false
PIPER_VOICE_MAP={"en":"en_US-lessac-medium.onnx","hi":"hi_IN-pratham-medium.onnx"}
TRANSLATION_TIMEOUT_SECONDS=180
TRANSLATION_KEEP_ALIVE=15m
HINDI_TRANSLATION_MODEL_DIR=/app/models/translation/m2m100_418m
HINDI_TRANSLATION_CPU_THREADS=4
HINDI_TRANSLATION_BEAM_SIZE=2
VOICE_MODEL_REUSE_MIN_MEMORY_GB=3.5
VOICE_PREWARM_MODELS=true

COPILOT_RETRIEVAL_LIMIT=5
COPILOT_ALLOWED_KNOWLEDGE_STATUSES=published

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
INTERNAL_WEBHOOK_SECRET=replace_with_a_random_webhook_secret

N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_NOTIFICATIONS_ENABLED=false
