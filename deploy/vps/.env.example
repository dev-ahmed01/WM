# Single-VPS deployment inputs. Copy to a gitignored deploy/vps/.env and fill EVERY value; never commit real secrets.
# Generate secrets with:  openssl rand -base64 36
WORKMATE_DOMAIN=workmate.example.com
# Postgres owner (migrations, backups). Used only inside the private network.
OWNER_DB_USER=workmate_owner
OWNER_DB_PASSWORD=
# Application login (non-owner, row-level security enforced).
APP_DB_USER=workmate_app
APP_DB_PASSWORD=
# 32+ chars each.
JWT_SECRET=
INTERNAL_WEBHOOK_SECRET=
# Models served by the private Ollama container (measured: ~2.6 GB RAM together).
LOCAL_CHAT_MODEL=qwen2.5:3b
LOCAL_EMBEDDING_MODEL=nomic-embed-text
# Pin a tested image tag instead of "latest" before go-live.
OLLAMA_IMAGE=ollama/ollama:latest
# Encrypted backups (age public key; keep the private key OFF the server).
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=14
