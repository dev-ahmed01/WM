# Staging operator inputs — copy to a gitignored .env.staging file outside
# version control. Never paste real passwords, API keys or URLs into a PR.
# Requires an existing managed PostgreSQL 16 instance. All three credentials
# target the same database. Create the non-owner runtime login separately.
STAGING_DOMAIN=workmate-staging.example.com
DATABASE_URL=postgresql://workmate_runtime:REPLACE_ME@db.example.net:5432/workmate_staging?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://workmate_migrator:REPLACE_ME@db.example.net:5432/workmate_staging?sslmode=verify-full
JWT_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
INTERNAL_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
# For encrypted offsite-compatible logical backups, set separately.
BACKUP_DATABASE_URL=postgresql://workmate_backup:REPLACE_ME@db.example.net:5432/workmate_staging?sslmode=verify-full
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_YOUR_BACKUP_PUBLIC_KEY
BACKUP_RETENTION_DAYS=7
