{
  "name": "Copilot Low-Confidence Escalation Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "escalation-webhook",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "options": {},
        "text": "WorkMate escalation {{$json.body.escalation_id}}: {{$json.body.reason}}"
      },
      "name": "Notify Supervisor",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [350, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Notify Supervisor", "type": "main", "index": 0 }]]
    }
  }
}
